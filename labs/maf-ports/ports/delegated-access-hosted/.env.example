# Port 15 delegated-access-hosted の環境変数(雛形)。実値はこのディレクトリの .env に置く(git 管理外)。
# 各部品はこの 1 つの命名体系を使う。値の出どころ:
#   [entra]  scripts/setup_entra.py --apply の stdout
#   [bicep]  infra/main.bicep のデプロイ出力(scripts/deploy_tools_server.sh も表示する)
#   [shared] 共有基盤 labs/maf-ports/infra/shared.bicep の出力(lab ルートの .env と同じ値)
#   [deploy] scripts/deploy_hosted_agent.py の stdout
# オフラインテスト(uv run pytest)はどれも使わない。

# === 共通 =============================================================================
# [entra] Entra テナント ID
ENTRA_TENANT_ID=
# [entra] dah-tools-api の appId(ツール API トークンの aud。infra/main.bicep の toolsApiClientId にも渡す)
TOOLS_API_CLIENT_ID=
# [entra] OBO の交換先スコープ api://<TOOLS_API_CLIENT_ID>/Tools.Access(空ならクライアント ID から組み立てる)
TOOLS_API_SCOPE=

# === 中間層バックエンド(uv run python -m delegated_access_maf.backend.main)===================
# [entra] dah-backend-api の appId(利用者トークンの aud。CLI のデバイスコードもこのアプリ)
BACKEND_API_CLIENT_ID=
# [entra] OBO と Foundry 用トークンの取得に使うクライアントシークレット。コミットしない
BACKEND_CLIENT_SECRET=
# [deploy] hosted agent の Responses URL 全体。方式 A / B は別エージェントなので、ここを差し替えて再起動する
#   https://<account>.services.ai.azure.com/api/projects/maf-ports/agents/delegated-access-apim/endpoint/protocols/openai/responses?api-version=v1
#   ローカルのコンテナ(hosting/main.py)なら http://localhost:8088/responses(Foundry 用トークンを付けない)
AGENT_RESPONSES_URL=
FOUNDRY_SCOPE=https://ai.azure.com/.default
BACKEND_PORT=8000

# === CLI(uv run delegated-access login / ask)=========================================
BACKEND_URL=http://localhost:8000
# MSAL のトークンキャッシュ(既定 ./.cache。git 管理外)
# DELEGATED_ACCESS_CACHE_DIR=.cache

# === hosted agent コンテナ(デプロイ定義の環境変数で渡る。ローカル起動時だけここから読む)====
# [bicep] 方式 A = apimGatewayUrl(https://apim-dah-<suffix>.azure-api.net)/ 方式 B = toolsServerUrl
TOOLS_BASE_URL=
# [shared] https://<account>.services.ai.azure.com/api/projects/maf-ports
FOUNDRY_PROJECT_ENDPOINT=
# [shared] モデルのデプロイ名(例 gpt-5.4-mini)
FOUNDRY_MODEL_NAME=
# 任意(既定 30 秒)。APIM Consumption の 1 リクエストの総所要時間の上限も 30 秒
# MCP_TIMEOUT_SECONDS=30

# === MCP ツールサーバー(Container Apps では Bicep が設定。ローカル起動時だけここから読む)=====
# server(方式 B: このサーバーが最終判定)| apim(方式 A: APIM の裏。署名と期限だけ再検証)
ENFORCEMENT_MODE=server
# [bicep] searchEndpoint。空なら同梱の data/docs をメモリで検索(ローカル確認用)
SEARCH_ENDPOINT=
SEARCH_INDEX=internal-docs
# 任意。空ならマネージド ID(DefaultAzureCredential。ユーザー割り当て MI は AZURE_CLIENT_ID で選ぶ)。
# scripts/setup_index.py は管理キーでも可
SEARCH_API_KEY=
# AZURE_CLIENT_ID=
# apim モードで必須: APIM が x-apim-gateway-secret ヘッダーで送る共有シークレット(Named Value dah-gateway-secret)。
# Azure では Bicep が Container Apps の secret として渡す。ローカルで apim モードを試すときだけ任意の値を入れる
APIM_GATEWAY_SECRET=
# SUPPLIERS_DATA=data/suppliers.json
# PORT=8080
# LOG_LEVEL=INFO
