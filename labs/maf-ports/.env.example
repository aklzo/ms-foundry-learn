# 共有基盤(infra/shared.bicep)のデプロイ出力から転記する
# 実値は .env に置く(.env は git 管理外)
FOUNDRY_PROJECT_ENDPOINT=https://<foundry>.services.ai.azure.com/api/projects/<project>
FOUNDRY_OPENAI_V1_ENDPOINT=https://<foundry>.openai.azure.com/openai/v1
FOUNDRY_MODEL=gpt-5.4-mini
# 認証はどちらか: (a) Entra ID(推奨。az login 済みなら DefaultAzureCredential が拾う)
# (b) API キー: az cognitiveservices account keys list -n <foundry> -g rg-maf-ports
FOUNDRY_API_KEY=
# トレース送信先(App Insights)。shared.bicep の出力 appInsightsConnectionString
APPLICATIONINSIGHTS_CONNECTION_STRING=
